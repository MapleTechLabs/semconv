---
import "../styles/global.css"
import Icon from "../components/Icon.astro"
import MapleMark from "../components/MapleMark.astro"
import SemconvMark from "../components/SemconvMark.astro"
import Palette from "../components/Palette.astro"
import { SITE } from "../lib/site.ts"

interface Props {
	title: string
	description: string
	/** Rendered small above the page heading. */
	kicker?: string
	wide?: boolean
}

const { title, description, wide = false } = Astro.props
const path = Astro.url.pathname
const nav = [
	{ href: "/changes", label: "Changes" },
	{ href: "/domains", label: "Domains" },
	{ href: "/attributes", label: "Registry" },
	{ href: "/spec", label: "Spec" },
	{ href: "/otlp", label: "OTLP" },
	{ href: "/diff", label: "Compare" },
	{ href: "/agents", label: "Agents" },
	{ href: "/about", label: "About" },
]
const isActive = (href: string) => path.startsWith(href)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title === SITE.name ? title : `${title} · ${SITE.name}`}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:url" content={new URL(path, Astro.site)} />
		<meta property="og:image" content={new URL("/og.png", Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
		<link rel="canonical" href={new URL(path, Astro.site)} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={`${SITE.name}: all changes`} href="/feed.xml" />
	</head>
	<body class="min-h-screen bg-canvas antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:border focus:border-ring focus:bg-surface focus:px-3 focus:py-2 focus:text-[13px]"
		>
			Skip to content
		</a>

		<header class="sticky top-0 z-20 border-b border-rule bg-canvas md:border-b-0">
			<div class:list={["mx-auto flex flex-wrap items-center gap-x-4 px-5 md:px-7", wide ? "max-w-[87rem]" : "max-w-[63rem]"]}>
				<a href="/" class="flex h-12 shrink-0 items-center gap-2 no-underline">
					<SemconvMark class="h-[18px] w-[18px] text-(--color-primary)" />
					<span class="text-sm font-semibold tracking-tight text-ink">{SITE.name}</span>
				</a>

				<nav
					class="site-nav order-last -mx-5 flex w-[calc(100%+2.5rem)] items-center gap-0.5 overflow-x-auto border-t border-rule px-3 py-1.5 md:order-none md:mx-0 md:w-auto md:border-0 md:px-0 md:py-0"
					aria-label="Site"
				>
					{
						nav.map((item) => {
							const active = isActive(item.href)
							return (
								<a
									href={item.href}
									aria-current={active ? "page" : undefined}
									class:list={[
										"flex h-7 shrink-0 items-center whitespace-nowrap rounded-md px-2.5 text-[13px] no-underline",
										active
											? "bg-canvas-accent font-medium text-ink hover:text-ink active:text-ink"
											: "text-muted hover:bg-canvas-accent/50 hover:text-ink active:bg-canvas-accent/50 active:text-ink",
									]}
								>
									{item.label}
								</a>
							)
						})
					}
				</nav>

				<form action="/search" method="get" role="search" class="ml-auto flex h-12 items-center">
					<label class="relative flex h-7.5 w-40 items-center rounded-lg border border-rule-strong bg-paper text-muted shadow-raised focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/24 sm:w-56">
						<Icon name="magnifier" class="pointer-events-none absolute left-2 h-3.5 w-3.5" />
						<input
							id="site-search"
							type="search"
							name="q"
							placeholder="Search"
							data-palette-trigger
							aria-label="Search"
							autocomplete="off"
							spellcheck="false"
							class="h-full w-full bg-transparent pl-7 pr-7 text-[13px] text-ink outline-none placeholder:text-faint"
						/>
						<kbd class="pointer-events-none absolute right-2 hidden font-mono text-[10px] font-medium text-faint sm:inline" data-palette-kbd>⌘K</kbd>
					</label>
				</form>
			</div>
			{/* The page panel's top edge rides under the bar, so the page keeps its corners while it scrolls. */}
			<div class="mx-2 hidden h-3 rounded-t-xl border border-b-0 border-rule bg-paper md:block" aria-hidden="true"></div>
		</header>

		<Palette />

		{/* The page sits on the canvas as an inset panel, the way Maple's dashboard sits beside its sidebar. */}
		<div class="bg-paper md:mx-2 md:rounded-b-xl md:border md:border-t-0 md:border-rule md:shadow-raised">
			<main
				id="main"
				tabindex="-1"
				class:list={["mx-auto min-h-[calc(100svh-15rem)] px-5 pt-8 pb-16 outline-none md:pt-6", wide ? "max-w-[86rem]" : "max-w-[62rem]"]}
			>
				<slot />
			</main>
		</div>

		<footer class="border-t border-rule md:border-t-0">
			<div
				class:list={[
					"mx-auto flex flex-col gap-8 px-5 py-10 text-[13px] text-muted md:flex-row md:items-start md:justify-between md:px-7",
					wide ? "max-w-[87rem]" : "max-w-[63rem]",
				]}
			>
				<div class="max-w-[48ch]">
					<a href="/" class="inline-flex items-center gap-2 no-underline">
						<SemconvMark class="h-[18px] w-[18px] text-(--color-primary)" />
						<span class="text-sm font-medium text-ink">{SITE.name}</span>
					</a>
					<p class="mt-3 mb-0 text-xs leading-relaxed">
						Data derived from the OpenTelemetry <a
							href="https://github.com/open-telemetry/semantic-conventions">semantic conventions</a
						>, <a href="https://github.com/open-telemetry/opentelemetry-specification">specification</a
						> and <a href="https://github.com/open-telemetry/opentelemetry-proto">protocol</a>. Not
						affiliated with the OpenTelemetry project or the CNCF.
					</p>
				</div>

				<div class="flex flex-wrap gap-x-12 gap-y-6">
					<div>
						<h4 class="eyebrow mb-3">Machine readable</h4>
						<ul class="m-0 list-none space-y-2 p-0 text-xs">
							<li><a href="/llms.txt" class="font-mono no-underline hover:underline">llms.txt</a></li>
							<li><a href="/feed.xml" class="no-underline hover:underline">RSS feed</a></li>
							<li><a href="/api/search.json" class="font-mono no-underline hover:underline">/api/search.json</a></li>
						</ul>
					</div>
					<div>
						<h4 class="eyebrow mb-3">Built by</h4>
						<a href={SITE.builderUrl} class="inline-flex items-center gap-1.5 text-xs no-underline hover:underline">
							<MapleMark class="h-[13px] w-[13px] text-[#E86F00]" />
							{SITE.builder}
						</a>
						<p class="mt-2 mb-0 max-w-[26ch] text-xs leading-relaxed">
							Open-source observability, built on OpenTelemetry.
						</p>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	// One handler for every copy button on any page.
	document.addEventListener("click", async (event) => {
		const button = (event.target as Element | null)?.closest<HTMLButtonElement>(".copy-btn")
		if (!button) return
		const done = (label: string) => {
			button.textContent = label
			setTimeout(() => (button.textContent = "Copy"), 1200)
		}
		await navigator.clipboard.writeText(button.dataset["copy"] ?? "").then(
			() => done("Copied"),
			() => done("Select it"),
		)
	})
</script>

<style>
	/* The phone nav strip scrolls sideways; a scrollbar would only add a rule. */
	.site-nav {
		scrollbar-width: none;
	}
	.site-nav::-webkit-scrollbar {
		display: none;
	}
</style>
