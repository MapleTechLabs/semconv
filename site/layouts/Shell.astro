---
import "../styles/global.css"
import MapleMark from "../components/MapleMark.astro"
import { SITE } from "../lib/site.ts"

interface Props {
	title: string
	description: string
	/** Rendered small and uppercase above the page heading. */
	kicker?: string
	wide?: boolean
}

const { title, description, wide = false } = Astro.props
const path = Astro.url.pathname
const nav = [
	{ href: "/", label: "Changes" },
	{ href: "/domains", label: "Domains" },
	{ href: "/attributes", label: "Registry" },
	{ href: "/spec", label: "Spec" },
	{ href: "/otlp", label: "OTLP" },
	{ href: "/diff", label: "Compare" },
	{ href: "/about", label: "About" },
]
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href))
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title === SITE.name ? title : `${title} · ${SITE.name}`}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="canonical" href={new URL(path, Astro.site)} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — all changes`} href="/feed.xml" />
	</head>
	<body class="min-h-screen antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:border focus:border-primary focus:bg-surface focus:px-3 focus:py-2 focus:text-[13px]"
		>
			Skip to content
		</a>

		<header class="sticky top-0 z-20 border-b border-rule bg-paper/95 backdrop-blur-md">
			<div class:list={["mx-auto flex flex-wrap items-stretch gap-x-5 px-5", wide ? "max-w-[86rem]" : "max-w-[62rem]"]}>
				<a href="/" class="flex h-14 shrink-0 items-center gap-2 no-underline hover:text-primary">
					<MapleMark class="h-5 w-5 text-primary" />
					<span class="text-[15px] font-semibold tracking-[-0.01em] text-ink">{SITE.name}</span>
				</a>

				<nav
					class="site-nav order-last -mx-5 flex w-[calc(100%+2.5rem)] items-stretch gap-1 overflow-x-auto border-t border-rule/60 px-3 md:order-none md:mx-0 md:w-auto md:border-0 md:px-0"
					aria-label="Site"
				>
					{
						nav.map((item) => {
							const active = isActive(item.href)
							return (
								<a
									href={item.href}
									aria-current={active ? "page" : undefined}
									class:list={[
										"group relative flex h-10 shrink-0 items-center whitespace-nowrap px-2.5 text-[13px] no-underline transition-colors md:h-14",
										active ? "font-medium text-ink" : "text-muted hover:text-ink",
									]}
								>
									{item.label}
									<span
										class:list={[
											"pointer-events-none absolute inset-x-1 -bottom-px h-0.5 bg-primary transition-opacity",
											active ? "opacity-100" : "opacity-0 group-hover:opacity-30",
										]}
									/>
								</a>
							)
						})
					}
				</nav>

				<form action="/search" method="get" role="search" class="ml-auto flex h-14 items-center">
					<label class="relative flex h-7 w-40 items-center rounded-lg border border-rule text-muted transition-colors focus-within:border-rule-strong hover:border-rule-strong sm:w-56">
						<svg class="pointer-events-none absolute left-2 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
							<circle cx="11" cy="11" r="7" />
							<path d="M20 20l-3.5-3.5" />
						</svg>
						<input
							id="site-search"
							type="search"
							name="q"
							placeholder="Search everything"
							aria-label="Search"
							autocomplete="off"
							spellcheck="false"
							class="h-full w-full bg-transparent pl-7 pr-7 text-xs text-ink outline-none placeholder:text-muted"
						/>
						<kbd class="pointer-events-none absolute right-2 hidden font-mono text-[10px] font-medium tracking-widest text-muted/70 sm:inline">/</kbd>
					</label>
				</form>
			</div>
		</header>

		<main id="main" tabindex="-1" class:list={["mx-auto px-5 py-10 outline-none", wide ? "max-w-[86rem]" : "max-w-[62rem]"]}>
			<slot />
		</main>

		<footer class="mt-20 border-t border-rule bg-deep">
			<div
				class:list={[
					"mx-auto flex flex-col gap-8 px-5 py-10 text-[13px] text-muted md:flex-row md:items-start md:justify-between",
					wide ? "max-w-[86rem]" : "max-w-[62rem]",
				]}
			>
				<div class="max-w-[48ch]">
					<a href="/" class="inline-flex items-center gap-2 no-underline">
						<MapleMark class="h-[18px] w-[18px] text-primary" />
						<span class="text-sm font-medium text-ink">{SITE.name}</span>
					</a>
					<p class="mt-3 mb-0 text-xs leading-relaxed">
						Data derived from the OpenTelemetry <a
							href="https://github.com/open-telemetry/semantic-conventions">semantic conventions</a
						>, <a href="https://github.com/open-telemetry/opentelemetry-specification">specification</a
						> and <a href="https://github.com/open-telemetry/opentelemetry-proto">protocol</a>. Not
						affiliated with the OpenTelemetry project or the CNCF.
					</p>
				</div>

				<div class="flex flex-wrap gap-x-12 gap-y-6">
					<div>
						<h4 class="eyebrow mb-3 text-ink">Machine readable</h4>
						<ul class="m-0 list-none space-y-2 p-0 text-xs">
							<li><a href="/llms.txt" class="font-mono no-underline hover:underline">llms.txt</a></li>
							<li><a href="/feed.xml" class="no-underline hover:underline">RSS feed</a></li>
							<li><a href="/api/search.json" class="font-mono no-underline hover:underline">/api/search.json</a></li>
						</ul>
					</div>
					<div>
						<h4 class="eyebrow mb-3 text-ink">Built by</h4>
						<a href={SITE.builderUrl} class="inline-flex items-center gap-1.5 text-xs no-underline hover:underline">
							<MapleMark class="h-[13px] w-[13px] text-[#E86F00]" />
							{SITE.builder}
						</a>
						<p class="mt-2 mb-0 max-w-[26ch] text-xs leading-relaxed">
							Open-source observability, built on OpenTelemetry.
						</p>
					</div>
				</div>
			</div>
		</footer>
		<script>
			// `/` focuses search, the reflex on any reference site.
			document.addEventListener("keydown", (event) => {
				const target = event.target as HTMLElement | null
				if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return
				if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return
				const field = document.getElementById("q") ?? document.getElementById("site-search")
				if (!(field instanceof HTMLInputElement)) return
				event.preventDefault()
				field.focus()
				field.select()
			})
		</script>
	</body>
</html>

<style>
	/* The phone nav strip scrolls sideways; a scrollbar would only add a rule. */
	.site-nav {
		scrollbar-width: none;
	}
	.site-nav::-webkit-scrollbar {
		display: none;
	}
</style>
