---
import { ICONS, type IconName } from "../lib/icons.ts"

interface Props {
	name: IconName
	class?: string
}
const { name, class: cls = "h-4 w-4" } = Astro.props
---

<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class:list={["shrink-0", cls]}>
	{ICONS[name].map((d) => <path d={d} stroke="currentColor" stroke-width="2" stroke-linecap="square" />)}
</svg>
