---
interface Props {
	label: string
	class?: string
	title?: string
}
const { label, class: cls = "", title } = Astro.props
---

<span
	class:list={["inline-flex h-[18px] shrink-0 items-center rounded-[4px] px-1.5 font-mono text-[10.5px] font-medium uppercase leading-none tracking-[0.06em] whitespace-nowrap", cls]}
	title={title}>{label}</span
>
