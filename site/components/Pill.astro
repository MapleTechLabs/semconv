---
interface Props {
	label: string
	class?: string
	title?: string
}
const { label, class: cls = "", title } = Astro.props
// Sentence case: labels arrive as `renamed` or `field added`, and nothing uppercases them now.
const text = label.charAt(0).toUpperCase() + label.slice(1)
---

<span
	class:list={["inline-flex h-[18px] shrink-0 items-center rounded-sm px-1.5 text-[11px] font-medium leading-none whitespace-nowrap", cls]}
	title={title}>{text}</span
>
