---
import ChangeList from "../../components/ChangeList.astro"
import Pill from "../../components/Pill.astro"
import Shell from "../../layouts/Shell.astro"
import { catalog, SOURCE_REPO } from "../../../src/model/catalog.ts"
import { buildDomains, DOMAINS, ruleDocs, ruleUrl } from "../../../src/model/domains.ts"
import { attributeHref, formatDate, inlineCode, kindLabel, severityClass, STABILITY_LABEL, stabilityClass } from "../../lib/format.ts"

export function getStaticPaths() {
	return DOMAINS.map((domain) => ({ params: { slug: domain.slug } }))
}

const { slug } = Astro.params
const data = await catalog()
const domain = buildDomains(data).find((d) => d.slug === slug)
if (!domain) throw new Error(`unknown domain: ${slug}`)

const linkable = new Set(data.attributes.map((a) => a.id))

const plain = (text: string) =>
	text
		.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
		.replace(/`/g, "")
		.replace(/\s+/g, " ")
		.trim()

/** Attribute rows keep the registry's grouping, so a namespace reads as a unit. */
const byNamespace = domain.namespaces.map((ns) => ({
	...ns,
	rows: domain.attributes.filter(({ attribute }) => attribute.namespace === ns.name),
}))

const signalGroups = [
	{ label: "Spans", signals: domain.spans },
	{ label: "Events", signals: domain.events },
	{ label: "Entities", signals: domain.entities },
].filter((group) => group.signals.length > 0)

const protoFiles = [...new Set(domain.governance.map((g) => g.protoFile).filter((f): f is string => Boolean(f)))]

/** Requirement sections come from two repositories; the path says which. */
const sectionUrl = (path: string, anchor: string) =>
	path.startsWith("specification/")
		? `${SOURCE_REPO.spec}/blob/v${data.spec.latest.version}/${path}#${anchor}`
		: `${SOURCE_REPO.proto}/blob/v${data.proto.latest.version}/${path}#${anchor}`

const shownRequirements = domain.requirements.slice(0, 8)

const rules = domain.def.rules
const wire = domain.wire

/** `blob/v1.11.1/opentelemetry/proto/common/v1/common.proto` -> `common.proto`. */
const docName = (url: string) => url.split("/").pop() ?? url

/** A proto comment's opening sentence, without the status and version markers that trail it. */
const lead = (comment: string | undefined) =>
	(comment ?? "")
		.split(/\s*(?:Status: \[|\[Since )/)[0]
		?.split(/(?<=\.)\s/)[0]
		?.trim() ?? ""

/** Messages under the file that defines them, in package order. */
const wireFiles = wire
	? [...new Set(wire.messages.map((m) => m.file))].map((file) => ({
			file,
			label: file.replace("opentelemetry/proto/", "").replace(/\.proto$/, ""),
			messages: wire.messages.filter((m) => m.file === file),
		}))
	: []

/** Wire changes counted in a sentence, where `kindLabel`'s chip wording has no plural. */
const WIRE_KIND: Record<string, readonly [one: string, many: string]> = {
	added: ["definition added", "definitions added"],
	removed: ["definition removed", "definitions removed"],
	"field-added": ["field added", "fields added"],
	"field-removed": ["field removed", "fields removed"],
	"field-renamed": ["field renamed", "fields renamed"],
	"field-number-changed": ["field renumbered", "fields renumbered"],
	"field-type-changed": ["field retyped", "fields retyped"],
	"field-label-changed": ["cardinality change", "cardinality changes"],
}

/** "12 fields renumbered · 8 fields removed", most frequent first. */
const byKind = (changes: readonly { readonly kind: string }[]) => {
	const counts = new Map<string, number>()
	for (const change of changes) counts.set(change.kind, (counts.get(change.kind) ?? 0) + 1)
	return [...counts.entries()]
		.sort((a, b) => b[1] - a[1])
		.map(([kind, count]) => `${count} ${WIRE_KIND[kind]?.[count === 1 ? 0 : 1] ?? kindLabel(kind)}`)
		.join(" · ")
}

const wireFacts = wire
	? [
			{ label: "OTLP/HTTP path", value: wire.def.httpPath },
			{ label: "gRPC method", value: `${wire.def.grpcService.split(".").pop()}/Export` },
			{ label: "Package", value: wire.def.packages[0] ?? "" },
		]
	: []

const jump = [
	rules && { href: "#rules", label: `Rules ${rules.items.length}` },
	wire && { href: "#wire", label: "Wire format" },
	signalGroups.length > 0 && { href: "#signals", label: "Signals" },
	domain.metrics.length > 0 && { href: "#metrics", label: `Metrics ${domain.metrics.length}` },
	{ href: "#specification", label: "Specification" },
	{ href: "#attributes", label: `Attributes ${domain.attributes.length}` },
	domain.changes.length > 0 && { href: "#changes", label: "Recent changes" },
].filter((item): item is { href: string; label: string } => Boolean(item))

const signalCount = domain.spans.length + domain.events.length + domain.entities.length

// A signal of its own has no metrics or spans to count; its messages are what it emits.
const stats = [
	{ value: domain.attributes.length, label: "Attributes" },
	...(wire
		? [{ value: wire.messages.filter((m) => m.kind === "message").length, label: "Messages" }]
		: [
				{ value: domain.metrics.length, label: "Metrics" },
				{ value: signalCount, label: "Signals" },
			]),
	{ value: domain.stable, label: "Stable" },
	{ value: domain.deprecated, label: "Deprecated" },
]

const description = wire
	? `${domain.title} in OpenTelemetry: the ${wire.def.what.toLowerCase()} signal's ${domain.attributes.length} attributes, its wire format at OTLP v${data.proto.latest.version} and the rules that bind them.`
	: `${domain.title} in OpenTelemetry: ${domain.attributes.length} attributes, ${domain.metrics.length} metrics and ${signalCount} signals, with the specification requirements that bind them.`
---

<Shell title={domain.title} description={description} wide>
	<nav class="text-[13px] text-faint">
		<a href="/domains">Domains</a> / {domain.title}
	</nav>

	<div class="mt-2 flex flex-wrap items-baseline gap-x-4 gap-y-1">
		<h1 class="page-title">{domain.title}</h1>
		<span class="text-[13.5px] text-faint">
			as of v{data.semconv.latest.version}
			{wire && <>, OTLP v{data.proto.latest.version}</>}
		</span>
	</div>
	<p class="mt-2 mb-0 text-muted max-w-[70ch]">{domain.blurb}</p>

	<p class="mt-3 mb-0 flex flex-wrap gap-x-2.5 gap-y-1 font-mono text-[12.5px] text-muted">
		{
			domain.namespaces.map((ns) => (
				<a href={`/attributes?q=${encodeURIComponent(`${ns.name}.`)}`} class="no-underline hover:underline">
					{ns.name}
					<span class="text-faint"> {ns.count}</span>
				</a>
			))
		}
	</p>

	<dl class="mt-7 grid grid-cols-3 gap-x-8 gap-y-4 sm:grid-cols-5 max-w-3xl">
		{
			stats.map((stat) => (
				<div class="m-0">
					<dt class="eyebrow">{stat.label}</dt>
					<dd class="stat-figure mt-1.5">{stat.value}</dd>
				</div>
			))
		}
	</dl>

	<nav class="mt-7 flex flex-wrap gap-x-4 gap-y-1 border-y border-rule py-2 text-[13px] text-muted">
		{jump.map((item) => <a href={item.href} class="no-underline hover:text-ink">{item.label}</a>)}
	</nav>

	{
		rules && (
			<section id="rules" class="mt-9">
				<h2 class="section-head">Rules</h2>
				<p class="mt-1 mb-0 text-[13px] text-muted max-w-[70ch]">
					What the lists below cannot show: these rules live in{" "}
					<span set:html={inlineCode(rules.where ?? "the convention's prose, not in its registry")} />. Paraphrased from{" "}
					{ruleDocs(rules).length === 1 ? (
						<a href={rules.doc} class="font-mono text-[12.5px]">
							{rules.doc.split("/blob/")[1]}
						</a>
					) : (
						ruleDocs(rules).map((doc, i) => (
							<>
								{i > 0 && ", "}
								<a href={doc} class="font-mono text-[12.5px]" title={doc.split("/blob/")[1]}>
									{docName(doc)}
								</a>
							</>
						))
					)}
					; the upstream wording wins.
				</p>
				<ul class="mt-3 m-0 list-none p-0">
					{rules.items.map((rule) => (
						<li class="border-b border-rule py-2.5">
							<div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
								<Pill
									label={rule.level}
									class={rule.level.startsWith("MUST") ? severityClass("notable") : "text-muted bg-elevated"}
								/>
								<a href={ruleUrl(rules, rule)} class="text-[13.5px] font-medium text-ink no-underline hover:underline">
									{rule.title}
								</a>
							</div>
							<p class="mt-1 mb-0 text-[13.5px] text-muted max-w-[80ch]" set:html={inlineCode(rule.text)} />
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		wire && (
			<section id="wire" class="mt-10">
				<h2 class="section-head">Wire format</h2>
				<p class="mt-1 mb-0 text-[13px] text-muted max-w-[70ch]">
					{wire.def.what} are a signal of their own, so what this domain emits is defined by a{" "}
					<code class="font-mono text-[0.92em]">.proto</code> package, not by spans or metrics in the registry.
				</p>

				<dl class="mt-4 m-0 grid gap-x-8 gap-y-3 sm:grid-cols-3">
					{wireFacts.map((fact) => (
						<div class="m-0 min-w-0">
							<dt class="eyebrow">{fact.label}</dt>
							<dd class="m-0 mt-0.5 font-mono text-[13px] break-all">{fact.value}</dd>
						</div>
					))}
				</dl>

				<div class="mt-7">
					<h3 class="m-0 text-[13px] font-semibold text-muted">Compatibility by release</h3>
					<p class="mt-1 mb-0 text-[13px] text-muted max-w-[70ch]">
						{wire.lastIncompatible ? (
							<>
								Last changed incompatibly in v{wire.lastIncompatible.version}.{" "}
								{wire.history.filter((r) => r.incompatible.length > 0).length} of the {wire.history.length} tracked
								releases removed, renumbered or retyped fields. The binary format keys on field numbers, so a
								sender and a receiver built against different releases do not fail: they decode the wrong fields.
							</>
						) : (
							<>No tracked release has changed this format incompatibly.</>
						)}
					</p>
					<ul class="mt-2 m-0 list-none p-0">
						{wire.history.map((release) => (
							<li class="grid gap-x-5 gap-y-1 sm:grid-cols-[minmax(0,11rem)_1fr] items-baseline border-b border-rule py-2">
								<span class="flex items-baseline gap-x-2.5">
									<a href={`/releases/proto/${release.version}`} class="font-mono text-[13.5px] font-medium no-underline hover:underline">
										v{release.version}
									</a>
									{release.publishedAt && <span class="text-[12.5px] text-faint">{formatDate(release.publishedAt)}</span>}
								</span>
								<div class="min-w-0 flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
									{release.incompatible.length > 0 ? (
										<Pill label={`${release.incompatible.length} incompatible`} class={severityClass("notable")} />
									) : (
										<Pill label="compatible" class="text-muted bg-elevated" />
									)}
									<span class="text-[13px] text-muted">
										{byKind(release.incompatible) ||
											(release.compatible.length > 0 ? byKind(release.compatible) : "No change to these packages.")}
									</span>
								</div>
							</li>
						))}
					</ul>
				</div>

				<div class="mt-7 flex flex-col gap-6">
					{wireFiles.map((group) => (
						<div>
							<h3 class="m-0 text-[13.5px] font-semibold">
								<a
									href={`${SOURCE_REPO.proto}/blob/v${data.proto.latest.version}/${group.file}`}
									class="font-mono no-underline hover:underline break-all"
								>
									{group.label}
								</a>
							</h3>
							<ul class="mt-1.5 m-0 list-none p-0">
								{group.messages.map((message) => (
									<li class="grid grid-cols-1 sm:grid-cols-[minmax(0,16rem)_1fr] gap-x-5 gap-y-0.5 items-baseline border-b border-rule py-2">
										<span class="font-mono text-[13.5px] font-medium break-all">{message.name.split(".").pop()}</span>
										<div class="min-w-0">
											{lead(message.comment) && <p class="m-0 text-[13px] text-muted">{lead(message.comment)}</p>}
											{message.fields.length > 0 && (
												<p class="m-0 mt-0.5 flex flex-wrap gap-x-2.5 gap-y-0.5 font-mono text-[12px] text-faint">
													{message.fields.map((field) => (
														<span>
															{field.number} <span class="text-muted">{field.name}</span>
														</span>
													))}
												</p>
											)}
										</div>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
				<p class="mt-3 mb-0 text-[13px] text-muted">
					Every signal's definitions are under <a href="/otlp">OTLP</a>.
				</p>
			</section>
		)
	}

	{
		signalGroups.length > 0 && (
			<section id="signals" class="mt-9">
				<h2 class="section-head">Signals</h2>
				<p class="mt-1 mb-0 text-[13px] text-muted max-w-[70ch]">
					What this domain emits, and the attributes each one carries, most strongly required first. An
					attribute marked <span class="text-breaking">*</span> is required on that signal;{" "}
					<span class="text-notable">*</span> is conditionally required.
				</p>
				<div class="mt-4 flex flex-col gap-6">
					{signalGroups.map((group) => (
						<div>
							<h3 class="m-0 text-[13px] font-semibold text-muted">
								{group.label} <span class="font-normal text-faint tabular-nums">{group.signals.length}</span>
							</h3>
							<ul class="mt-1.5 m-0 list-none p-0">
								{group.signals.map((signal) => (
									<li class="border-b border-rule py-2">
										<div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
											<span class="font-mono text-[13.5px] font-medium break-all">
												{signal.name.replace(/^(span|event|entity)\./, "")}
											</span>
											{signal.spanKind && (
												<span class="tag">{signal.spanKind}</span>
											)}
											<Pill
												label={
													signal.deprecated
														? "Deprecated"
														: (STABILITY_LABEL[signal.stability] ?? signal.stability)
												}
												class={stabilityClass(signal.stability, Boolean(signal.deprecated))}
											/>
											<span class="text-[13px] text-muted">{plain(signal.brief).slice(0, 120)}</span>
										</div>
										{signal.attributes.length > 0 && (
											<p class="mt-1 mb-0 flex flex-wrap gap-x-2.5 gap-y-0.5 font-mono text-[12px] text-muted">
												{(domain.signalAttributes.get(signal.id) ?? []).slice(0, 12).map((entry) => (
													<span>
														{linkable.has(entry.id) ? (
															<a href={attributeHref(entry.id)} class="no-underline hover:underline">
																{entry.id}
															</a>
														) : (
															entry.id
														)}
														{entry.level === "required" && <span class="text-breaking">*</span>}
														{entry.level === "conditionally_required" && <span class="text-notable">*</span>}
													</span>
												))}
												{signal.attributes.length > 12 && (
													<span class="text-faint">+{signal.attributes.length - 12} more</span>
												)}
											</p>
										)}
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</section>
		)
	}

	{
		domain.metrics.length > 0 && (
			<section id="metrics" class="mt-10">
				<h2 class="section-head">
					Metrics <span class="font-normal text-faint tabular-nums">{domain.metrics.length}</span>
				</h2>
				<ul class="mt-2 m-0 list-none p-0">
					{domain.metrics.map((metric) => (
						<li class="grid gap-x-5 gap-y-1 sm:grid-cols-[minmax(0,24rem)_1fr] items-baseline border-b border-rule py-2">
							<span class="font-mono text-[13.5px] break-all">{metric.name}</span>
							<div class="min-w-0 flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
								<Pill
									label={
										metric.deprecated ? "Deprecated" : (STABILITY_LABEL[metric.stability] ?? metric.stability)
									}
									class={stabilityClass(metric.stability, Boolean(metric.deprecated))}
								/>
								<span class="font-mono text-[12px] text-faint">
									{metric.instrument} · {metric.unit || "1"}
								</span>
								<span class="text-[13px] text-muted truncate">{plain(metric.brief).slice(0, 140)}</span>
							</div>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section id="specification" class="mt-11">
		<h2 class="section-head">Specification</h2>

		{
			domain.governance.length > 0 && (
				<ul class="mt-2 m-0 list-none p-0">
					{domain.governance.map((entry) => (
						<li class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-b border-rule py-2">
							<span class="text-[13.5px] font-medium">{entry.what}</span>
							<span class="text-[13.5px] text-muted">
								are bound by the{" "}
								<a href={`/spec#area-${entry.area}`} class="font-mono text-[13px]">
									{entry.area}
								</a>{" "}
								specification &mdash; {entry.count} requirements across {entry.documents} documents,{" "}
								{entry.binding} of them MUST or SHALL.
							</span>
						</li>
					))}
				</ul>
			)
		}

		{
			shownRequirements.length > 0 ? (
				<div class="mt-6">
					<h3 class="m-0 text-[13px] font-semibold text-muted">
						{wire ? "Requirements that bind this signal" : "Requirements that name this domain"}{" "}
						<span class="font-normal text-faint tabular-nums">{domain.requirements.length}</span>
					</h3>
					<ul class="mt-2 m-0 list-none p-0">
						{shownRequirements.map(({ statement, section }) => (
							<li class="border-b border-rule py-2">
								<div class="flex flex-wrap items-baseline gap-x-2.5">
									<Pill
										label={statement.level}
										class={statement.level.startsWith("MUST") ? severityClass("notable") : "text-muted bg-elevated"}
									/>
									<a href={sectionUrl(section.path, section.anchor)} class="text-[12.5px] text-muted">
										{section.title}
									</a>
									<span class="tag">{section.status}</span>
								</div>
								<p class="mt-1 mb-0 text-[13.5px] max-w-[80ch]" set:html={inlineCode(statement.text)} />
							</li>
						))}
					</ul>
					{domain.requirements.length > shownRequirements.length && (
						<p class="mt-2 mb-0 text-[13px]">
							<a href={`/search?q=${encodeURIComponent(domain.def.keywords?.[0] ?? domain.title)}&type=requirement`} class="text-muted">
								All {domain.requirements.length} matching requirements
							</a>
						</p>
					)}
				</div>
			) : (
				<p class="mt-4 mb-0 text-[13.5px] text-muted max-w-[70ch]">
					The specification prose never names this domain. That is not an omission: the specification
					defines signals, not subject matter &mdash; what binds{" "}
					<span class="font-mono text-[0.92em]">{domain.namespaces[0]?.name}</span> telemetry is the
					general rules above, and the conventions themselves carry the rest.
				</p>
			)
		}

		{
			protoFiles.length > 0 && (
				<p class="mt-5 mb-0 text-[13px] text-muted max-w-[70ch]">
					On the wire, this lands in{" "}
					{protoFiles.map((file, i) => (
						<>
							{i > 0 && ", "}
							<a href={`${SOURCE_REPO.proto}/blob/v${data.proto.latest.version}/${file}`} class="font-mono text-[12.5px]">
								{file.replace("opentelemetry/proto/", "").replace(/\.proto$/, "")}
							</a>
						</>
					))}
					. Field-by-field definitions are under <a href="/otlp">OTLP</a>.
				</p>
			)
		}
	</section>

	<section id="attributes" class="mt-11">
		<h2 class="section-head">
			Attributes <span class="font-normal text-faint tabular-nums">{domain.attributes.length}</span>
		</h2>
		<div class="mt-4 flex flex-col gap-7">
			{
				byNamespace.map((group) => (
					<div>
						<h3 class="m-0 flex flex-wrap items-baseline gap-x-2.5 font-mono text-[13.5px] font-semibold">
							{group.name}
							<span class="font-sans text-[12px] font-normal text-faint">
								{group.count} {group.count === 1 ? "attribute" : "attributes"}
							</span>
						</h3>
						<ul class="mt-1.5 m-0 list-none p-0">
							{group.rows.map(({ attribute, registry }) => (
								<li class="grid gap-x-5 gap-y-1 sm:grid-cols-[minmax(0,22rem)_1fr] items-baseline border-b border-rule py-2">
									<a
										href={attributeHref(attribute.id)}
										class="font-mono text-[13.5px] font-medium no-underline hover:underline break-all"
									>
										{attribute.id}
									</a>
									<div class="min-w-0 flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
										<Pill
											label={
												attribute.deprecated
													? "Deprecated"
													: (STABILITY_LABEL[attribute.stability] ?? attribute.stability)
											}
											class={stabilityClass(attribute.stability, Boolean(attribute.deprecated))}
										/>
										{registry === "genai" && (
											<Pill label="GenAI" class="text-rc bg-rc-bg" title="Defined in the GenAI conventions registry" />
										)}
										{attribute.deprecated?.renamedTo && (
											<a href={attributeHref(attribute.deprecated.renamedTo)} class="font-mono text-[12.5px] text-muted">
												&rarr; {attribute.deprecated.renamedTo}
											</a>
										)}
										<span class="text-[13px] text-muted truncate">{plain(attribute.brief).slice(0, 160)}</span>
									</div>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	{
		domain.changes.length > 0 && (
			<section id="changes" class="mt-11">
				<h2 class="section-head">Recent changes</h2>
				<p class="mt-1 mb-0 text-[13px] text-muted">
					Breaking and notable changes to this domain across the last{" "}
					{Math.min(6, data.semconv.diffs.length)} semantic-conventions releases.
				</p>
				<div class="mt-3">
					<ChangeList changes={domain.changes.slice(0, 10).map((entry) => entry.change)} linkable={linkable} />
				</div>
				{domain.changes.length > 10 && (
					<p class="mt-2 mb-0 text-[13px]">
						<a href={`/releases/semconv/${data.semconv.latest.version}`} class="text-muted">
							{domain.changes.length - 10} more in the full release history
						</a>
					</p>
				)}
			</section>
		)
	}

	<p class="mt-12 mb-0 text-[13px] text-faint max-w-[70ch]">
		Topics are this site's grouping of upstream namespaces, not a structure the OpenTelemetry project
		publishes. <a href={`/api/domains.json`} class="font-mono">JSON</a> ·{" "}
		<a href="/domains">All domains</a>
	</p>
</Shell>
