---
import ChangeList from "../components/ChangeList.astro"
import Pill from "../components/Pill.astro"
import Shell from "../layouts/Shell.astro"
import { catalog, SOURCE_LABEL, SOURCES } from "../../src/model/catalog.ts"
import { formatDate, severityClass } from "../lib/format.ts"
import { SITE } from "../lib/site.ts"

const data = await catalog()
const linkable = new Set(data.attributes.map((a) => a.id))

const requirements = data.spec.latest.sections.reduce((n, section) => n + section.normative.length, 0)

/**
 * Three separately-versioned repositories, which is the whole reason keeping up
 * is hard. Each card says where that source stands today.
 */
const sourceCards = [
	{
		id: "semconv" as const,
		href: "/attributes",
		blurb: `${data.attributes.length} attributes, ${data.metrics.length} metrics. ${data.renames.size} have been renamed to something else.`,
	},
	{
		id: "spec" as const,
		href: "/spec",
		blurb: `${data.spec.latest.documents.length} documents carrying ${requirements} MUST, SHOULD and MAY requirements.`,
	},
	{
		id: "proto" as const,
		href: "/otlp",
		blurb: `${data.proto.latest.messages.length} wire definitions plus the protocol requirements every OTLP server is bound by.`,
	},
].map((card) => {
	const source = data.source(card.id)
	return { ...card, version: source.latest.version, publishedAt: source.release(source.latest.version)?.publishedAt }
})

const feed = data.feed.map((entry) => ({
	...entry,
	significant: entry.diff.changes.filter((c) => c.severity !== "informational"),
}))
---

<Shell title={SITE.name} description={SITE.description}>
	<section class="border-b border-rule pb-9">
		<h1 class="m-0 text-[2.1rem] leading-[1.15] font-semibold tracking-[-0.02em] max-w-[19ch]">
			{SITE.tagline}
		</h1>
		<p class="mt-4 mb-0 max-w-[62ch] text-muted">
			OpenTelemetry is three separately-versioned repositories, and none of them will tell you what
			moved since you last looked. This reads all three at every release: which attributes were
			renamed, which requirements appeared in a stable document, and which fields changed on the
			wire.
		</p>

		<div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-3">
			{
				sourceCards.map((card) => (
					<div>
						<h2 class="m-0 text-[13.5px] font-semibold">
							<a href={card.href} class="no-underline hover:underline">
								{SOURCE_LABEL[card.id]}
							</a>
						</h2>
						<p class="mt-1 mb-0 font-mono text-[1.15rem] leading-none font-medium">v{card.version}</p>
						{card.publishedAt && (
							<p class="mt-1 mb-0 text-[12px] text-faint">{formatDate(card.publishedAt)}</p>
						)}
						<p class="mt-2 mb-0 text-[13px] text-muted">{card.blurb}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="mt-10">
		<h2 class="text-[11px] uppercase tracking-[0.12em] text-faint font-semibold m-0">Release history</h2>

		<div class="mt-5 flex flex-col gap-9">
			{
				feed.map(({ source, version, diff, release, significant }) => (
					<article>
						<header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
							<h3 class="m-0 text-[1.05rem] font-semibold tracking-tight">
								<a href={`/releases/${source}/${version}`} class="no-underline hover:underline">
									<span class="text-muted font-normal text-[0.9em]">{SOURCE_LABEL[source]}</span>{" "}
									<span class="font-mono">v{version}</span>
								</a>
							</h3>
							{release && (
								<time class="text-[13px] text-faint" datetime={release.publishedAt}>
									{formatDate(release.publishedAt)}
								</time>
							)}
							<span class="flex gap-1.5 ml-auto">
								{diff.counts.breaking > 0 && (
									<Pill label={`${diff.counts.breaking} breaking`} class={severityClass("breaking")} />
								)}
								{diff.counts.notable > 0 && (
									<Pill label={`${diff.counts.notable} notable`} class={severityClass("notable")} />
								)}
							</span>
						</header>

						{significant.length === 0 ? (
							<p class="mt-2 mb-0 text-[13.5px] text-faint">
								Editorial only &mdash; {diff.counts.informational} wording, example and guidance changes.
							</p>
						) : (
							<div class="mt-2">
								<ChangeList changes={significant.slice(0, 6)} linkable={linkable} />
							</div>
						)}

						<p class="mt-2.5 mb-0 text-[13px] text-faint flex flex-wrap gap-x-4">
							<a href={`/releases/${source}/${version}`} class="text-muted">
								{significant.length > 6
									? `All ${significant.length} notable changes`
									: `Full diff from v${diff.from}`}
								{diff.counts.informational > 0 && ` + ${diff.counts.informational} editorial`}
							</a>
							{release && <a href={release.url}>Upstream release notes</a>}
						</p>
					</article>
				))
			}
		</div>

		<p class="mt-10 mb-0 text-[13px] text-faint max-w-[62ch]">
			History starts at {SOURCES.map((id) => `${SOURCE_LABEL[id]} v${data.source(id).versions.at(-1)}`).join(", ")}.
			Going further back would mean diffing across schema and layout changes that would report churn
			the projects never made.
		</p>
	</section>
</Shell>
