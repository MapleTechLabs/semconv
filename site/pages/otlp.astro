---
import Pill from "../components/Pill.astro"
import Shell from "../layouts/Shell.astro"
import { catalog, SOURCE_REPO } from "../../src/model/catalog.ts"
import { inlineCode, severityClass } from "../lib/format.ts"

const data = await catalog()
const snapshot = data.proto.latest
const tag = `v${snapshot.version}`

const isDevelopment = (name: string) => name.includes("development")

/** Grouped by proto file, which is also how the signals divide. */
const files = [...new Set(snapshot.messages.map((m) => m.file))].sort().map((file) => ({
	file,
	label: file.replace("opentelemetry/proto/", "").replace(/\.proto$/, ""),
	development: isDevelopment(file),
	messages: snapshot.messages.filter((m) => m.file === file),
}))

const requirements = snapshot.sections.flatMap((section) =>
	section.normative.map((statement) => ({ statement, section })),
)

/**
 * Server-side MUSTs are the ones an OTLP receiver is judged on, and they are
 * the reason this page exists at all: they live in the proto repository, not in
 * the specification one, so almost nobody reads them.
 */
const serverRules = requirements.filter(
	(r) => /\bserver\b/i.test(r.statement.text) && r.statement.level.startsWith("MUST"),
)

const totals = {
	messages: snapshot.messages.filter((m) => m.kind === "message").length,
	enums: snapshot.messages.filter((m) => m.kind === "enum").length,
	stable: snapshot.messages.filter((m) => !isDevelopment(m.name)).length,
}

/** Zero breaking changes across every tracked release is a claim worth making. */
const breakingSoFar = data.proto.diffs.reduce((n, diff) => n + diff.counts.breaking, 0)
---

<Shell
	title="OTLP"
	description={`The OpenTelemetry protocol at v${snapshot.version}: ${totals.messages} messages and ${totals.enums} enums on the wire, plus the ${requirements.length} requirements every OTLP client and server is bound by.`}
	wide
>
	<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
		<h1 class="m-0 text-[1.7rem] font-semibold tracking-[-0.02em]">OTLP</h1>
		<span class="text-[13.5px] text-faint">as of v{snapshot.version}</span>
	</div>
	<p class="mt-2 mb-0 text-muted max-w-[68ch]">
		The wire format, and the protocol rules that go with it. Worth knowing where those rules live:
		the OTLP specification is <em>not</em> in the specification repository &mdash;{" "}
		<code class="font-mono text-[0.92em]">specification/protocol/otlp.md</code> is a stub redirecting
		to the website, and the real document ships in{" "}
		<code class="font-mono text-[0.92em]">docs/specification.md</code>, beside the{" "}
		<code class="font-mono text-[0.92em]">.proto</code> files. Both are tracked here.
	</p>

	<dl class="mt-7 grid grid-cols-2 gap-x-8 gap-y-4 sm:grid-cols-4 max-w-2xl">
		{
			[
				{ value: totals.messages, label: "messages" },
				{ value: totals.enums, label: "enums" },
				{ value: requirements.length, label: "protocol rules" },
				{ value: breakingSoFar, label: "breaking changes tracked" },
			].map((stat) => (
				<div class="m-0">
					<dt class="text-[12px] uppercase tracking-wide text-faint">{stat.label}</dt>
					<dd class="m-0 font-mono text-[1.6rem] leading-none font-medium">{stat.value}</dd>
				</div>
			))
		}
	</dl>
	{
		breakingSoFar === 0 && (
			<p class="mt-3 mb-0 text-[13px] text-muted max-w-[68ch]">
				No breaking change to a released wire definition across any tracked release. Every removal and
				renumbering below happened inside a <code class="font-mono text-[0.92em]">v1development</code>{" "}
				package, where the project has made no compatibility promise.
			</p>
		)
	}

	{
		serverRules.length > 0 && (
			<section class="mt-10">
				<h2 class="text-[11px] uppercase tracking-[0.12em] text-faint font-semibold m-0">
					Server obligations
				</h2>
				<p class="mt-1 mb-0 text-[13px] text-muted max-w-[68ch]">
					The MUSTs that name the server. If you operate an OTLP endpoint, this is the list you are
					judged against.
				</p>
				<ul class="mt-3 m-0 list-none p-0">
					{serverRules.map(({ statement, section }) => (
						<li class="border-b border-rule py-2 last:border-0">
							<div class="flex flex-wrap items-baseline gap-x-2.5">
								<Pill label={statement.level} class={severityClass("notable")} />
								<a
									href={`${SOURCE_REPO.proto}/blob/${tag}/${section.path}#${section.anchor}`}
									class="text-[12.5px] text-muted"
								>
									{section.title}
								</a>
							</div>
							<p class="mt-1 mb-0 text-[13.5px]" set:html={inlineCode(statement.text)} />
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="mt-11">
		<h2 class="text-[11px] uppercase tracking-[0.12em] text-faint font-semibold m-0">Wire definitions</h2>

		<div class="mt-4 flex flex-col gap-8">
			{
				files.map((group) => (
					<div>
						<h3 class="m-0 flex flex-wrap items-baseline gap-x-2.5 text-[13.5px] font-semibold">
							<a href={`${SOURCE_REPO.proto}/blob/${tag}/${group.file}`} class="font-mono no-underline hover:underline">
								{group.label}
							</a>
							{group.development && (
								<Pill label="development" class="text-muted bg-rule/50" title="No compatibility promise" />
							)}
						</h3>
						<ul class="mt-1.5 m-0 list-none p-0">
							{group.messages.map((message) => (
								<li class="grid grid-cols-[minmax(0,20rem)_1fr] gap-x-5 items-baseline border-b border-rule py-1.5">
									<span class="font-mono text-[13px] break-all">
										{message.name.split(".").slice(-2).join(".")}
									</span>
									<span class="text-[12.5px] text-muted">
										{message.kind === "enum"
											? message.values.map((v) => `${v.name}=${v.number}`).join("  ")
											: message.fields
													.map((f) => `${f.number} ${f.name}`)
													.join("  ") || "no fields"}
									</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<p class="mt-10 mb-0 text-[13px] text-faint max-w-[68ch]">
		Both OTLP encodings are load-bearing, which is why almost any change to an existing field counts
		as breaking here: the binary format keys on the field <em>number</em>, and OTLP/JSON keys on the
		field <em>name</em>. Renaming a field breaks every JSON client even though the binary wire format
		never notices. Full definitions in <a href="/api/otlp.json" class="font-mono">JSON</a>.
	</p>
</Shell>
