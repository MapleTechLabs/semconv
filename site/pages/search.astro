---
import Shell from "../layouts/Shell.astro"
import { catalog } from "../../src/model/catalog.ts"
import { buildDomains, registryAttributes } from "../../src/model/domains.ts"

const data = await catalog()
const domains = buildDomains(data)

const requirements = [...data.spec.latest.sections, ...data.proto.latest.sections].reduce(
	(n, section) => n + section.normative.length,
	0,
)
const total =
	domains.length +
	registryAttributes(data).length +
	data.metrics.length +
	data.genai.latest.metrics.length +
	data.signals.length +
	data.genai.latest.signals.length +
	requirements +
	data.proto.latest.messages.length

const types = [
	["all", "Everything"],
	["attribute", "Attributes"],
	["metric", "Metrics"],
	["signal", "Signals"],
	["requirement", "Requirements"],
	["otlp", "OTLP"],
	["domain", "Domains"],
] as const
---

<Shell
	title="Search"
	description="Search the OpenTelemetry semantic conventions, specification requirements, OTLP messages, metrics and signals in one box."
	wide
>
	<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
		<h1 class="page-title">Search</h1>
		<span class="text-[13.5px] text-faint">{total.toLocaleString("en-GB")} definitions</span>
	</div>
	<p class="mt-2 mb-0 text-muted max-w-[68ch]">
		Attributes and metrics from both registries, every span, event and entity, every RFC 2119
		requirement in the specification and in OTLP, and the wire definitions &mdash; in one box.
	</p>

	<div class="mt-6">
		<input
			id="q"
			type="search"
			placeholder="db.query.text, retry, gen_ai, span limits…"
			autocomplete="off"
			spellcheck="false"
			autofocus
			class="w-full field h-10 font-mono text-[14px]"
		/>
		<div class="mt-3 flex flex-wrap gap-1.5" role="group" aria-label="Filter by result type">
			{
				types.map(([value, label]) => (
					<button
						type="button"
						data-type={value}
						class="type-btn chip-btn"
						data-on={value === "all" ? "" : undefined}
					>
						{label}
						<span class="type-count font-mono text-[11.5px] text-faint"></span>
					</button>
				))
			}
		</div>
	</div>

	<p id="status" class="mt-4 mb-0 text-[13px] text-faint" aria-live="polite">Loading the index…</p>

	<ul id="results" class="mt-2 m-0 list-none p-0"></ul>

	<noscript>
		<p class="mt-6 text-muted">
			Search needs JavaScript. Without it, the <a href="/attributes">registry</a> and{" "}
			<a href="/domains">domain pages</a> are browsable, and the raw index is at{" "}
			<a href="/api/search.json" class="font-mono">/api/search.json</a>.
		</p>
	</noscript>

	<p class="mt-12 mb-0 text-[13px] text-faint max-w-[68ch]">
		Every term you type has to land somewhere: an identifier, a segment of one
		(<code class="code-chip">status</code> finds <code class="code-chip">http.response.status_code</code>),
		a description or a requirement. Prefix with <code class="code-chip">attr:</code>,
		<code class="code-chip">metric:</code>, <code class="code-chip">spec:</code> or
		<code class="code-chip">otlp:</code> to narrow. A deprecated name shows what replaced it.
		For a question in plain words, <a href="/agents">point your agent at the MCP server</a>. Requirements and OTLP messages link upstream, to the document
		at the tracked tag. The whole index is one file:{" "}
		<a href="/api/search.json" class="font-mono">/api/search.json</a>.
	</p>
</Shell>

<script>
	import { SIGNAL_TYPES, TYPE_LABEL, highlight, loadIndex, rememberQuery, search, type Indexed } from "../lib/search-client.ts"

	const input = document.getElementById("q") as HTMLInputElement
	const results = document.getElementById("results") as HTMLElement
	const status = document.getElementById("status") as HTMLElement
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".type-btn"))

	const LIMIT = 80
	let entries: Indexed[] = []
	let type = "all"

	const setType = (next: string) => {
		type = next
		for (const button of buttons) button.toggleAttribute("data-on", button.dataset["type"] === next)
	}

	function render() {
		const raw = input.value.trim()
		if (raw === "") {
			results.replaceChildren()
			status.textContent = `${entries.length.toLocaleString("en-GB")} definitions indexed. Start typing.`
			for (const button of buttons) (button.querySelector(".type-count") as HTMLElement).textContent = ""
			return
		}

		const result = search(entries, raw, { type, limit: LIMIT })
		// A typed prefix is a filter; reflect it in the buttons rather than fight it.
		if (result.query.type && result.query.type !== type) setType(result.query.type)

		for (const button of buttons) {
			const value = button.dataset["type"] ?? "all"
			const count = button.querySelector(".type-count") as HTMLElement
			const n =
				value === "all"
					? Object.values(result.perType).reduce((sum, x) => sum + x, 0)
					: value === "signal"
						? [...SIGNAL_TYPES].reduce((sum, key) => sum + (result.perType[key] ?? 0), 0)
						: (result.perType[value] ?? 0)
			count.textContent = ` ${n}`
			button.classList.toggle("opacity-40", value !== "all" && n === 0)
		}

		results.replaceChildren(...result.hits.map((hit) => row(hit, result.query.terms)))
		status.textContent =
			result.total === 0
				? "Nothing matches. Fewer words, or a different spelling?"
				: result.total > LIMIT
					? `Showing the first ${LIMIT} of ${result.total} matches.`
					: `${result.total} ${result.total === 1 ? "match" : "matches"}.`

		const url = new URL(location.href)
		url.searchParams.set("q", raw)
		if (type === "all") url.searchParams.delete("type")
		else url.searchParams.set("type", type)
		history.replaceState(null, "", url)
	}

	function row(entry: Indexed, terms: readonly string[]): HTMLElement {
		const li = document.createElement("li")
		li.className = "border-b border-rule py-2"

		const head = document.createElement("div")
		head.className = "flex flex-wrap items-baseline gap-x-2.5 gap-y-1"

		const tag = document.createElement("span")
		tag.className = "font-mono text-[10.5px] uppercase tracking-[0.08em] text-faint w-[5.5rem] shrink-0"
		tag.textContent = TYPE_LABEL[entry.type] ?? entry.type

		const link = document.createElement("a")
		link.href = entry.url
		link.className = "font-mono text-[13.5px] font-medium break-all no-underline hover:underline"
		link.innerHTML = highlight(entry.id, terms)
		link.addEventListener("click", () => rememberQuery(input.value))

		head.append(tag, link)

		if (entry.renamedTo) {
			const successor = document.createElement("a")
			successor.href = `/attributes/${encodeURIComponent(entry.renamedTo)}`
			successor.className = "font-mono text-[12.5px] text-muted"
			successor.textContent = `→ ${entry.renamedTo}`
			head.append(successor)
		}

		const meta = document.createElement("span")
		meta.className = "text-[12px] text-faint"
		meta.textContent = entry.meta
		head.append(meta)

		const body = document.createElement("p")
		body.className = "mt-0.5 mb-0 pl-0 sm:pl-[5.5rem] text-[13.5px] text-muted max-w-[86ch]"
		body.innerHTML = highlight(entry.text, terms)

		li.append(head)
		if (entry.text) li.append(body)
		return li
	}

	for (const button of buttons) {
		button.addEventListener("click", () => {
			setType(button.dataset["type"] ?? "all")
			render()
		})
	}
	input.addEventListener("input", render)

	const params = new URLSearchParams(location.search)
	input.value = params.get("q") ?? ""
	const initialType = params.get("type")
	if (initialType && buttons.some((b) => b.dataset["type"] === initialType)) setType(initialType)

	entries = await loadIndex()
	render()
	input.focus()
</script>
