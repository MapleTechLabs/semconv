---
import Shell from "../layouts/Shell.astro"
import { catalog } from "../../src/model/catalog.ts"
import { buildDomains, registryAttributes } from "../../src/model/domains.ts"

const data = await catalog()
const domains = buildDomains(data)

const requirements = [...data.spec.latest.sections, ...data.proto.latest.sections].reduce(
	(n, section) => n + section.normative.length,
	0,
)
const total =
	domains.length +
	registryAttributes(data).length +
	data.metrics.length +
	data.genai.latest.metrics.length +
	data.signals.length +
	data.genai.latest.signals.length +
	requirements +
	data.proto.latest.messages.length

const types = [
	["all", "Everything"],
	["attribute", "Attributes"],
	["metric", "Metrics"],
	["signal", "Signals"],
	["requirement", "Requirements"],
	["otlp", "OTLP"],
	["domain", "Domains"],
] as const
---

<Shell
	title="Search"
	description="Search the OpenTelemetry semantic conventions, specification requirements, OTLP messages, metrics and signals in one box."
	wide
>
	<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
		<h1 class="m-0 text-[1.7rem] font-semibold tracking-[-0.02em]">Search</h1>
		<span class="text-[13.5px] text-faint">{total.toLocaleString("en-GB")} definitions</span>
	</div>
	<p class="mt-2 mb-0 text-muted max-w-[68ch]">
		Attributes and metrics from both registries, every span, event and entity, every RFC 2119
		requirement in the specification and in OTLP, and the wire definitions &mdash; in one box.
	</p>

	<div class="mt-6">
		<input
			id="q"
			type="search"
			placeholder="db.query.text, retry, gen_ai, span limits…"
			autocomplete="off"
			spellcheck="false"
			autofocus
			class="w-full rounded-md border border-rule bg-surface px-3 py-2.5 font-mono text-[14px] outline-none focus:border-rule-strong"
		/>
		<div class="mt-3 flex flex-wrap gap-1.5" role="group" aria-label="Filter by result type">
			{
				types.map(([value, label]) => (
					<button
						type="button"
						data-type={value}
						class="type-btn rounded-md border border-rule px-2.5 py-1 text-[13px] text-muted hover:text-ink data-[on]:border-rule-strong data-[on]:text-ink data-[on]:font-medium"
						data-on={value === "all" ? "" : undefined}
					>
						{label}
						<span class="type-count font-mono text-[11.5px] text-faint"></span>
					</button>
				))
			}
		</div>
	</div>

	<p id="status" class="mt-4 mb-0 text-[13px] text-faint" aria-live="polite">Loading the index…</p>

	<ul id="results" class="mt-2 m-0 list-none p-0"></ul>

	<noscript>
		<p class="mt-6 text-muted">
			Search needs JavaScript. Without it, the <a href="/attributes">registry</a> and{" "}
			<a href="/domains">domain pages</a> are browsable, and the raw index is at{" "}
			<a href="/api/search.json" class="font-mono">/api/search.json</a>.
		</p>
	</noscript>

	<p class="mt-12 mb-0 text-[13px] text-faint max-w-[68ch]">
		Matching is plain substring, across identifiers, descriptions and requirement text; every term
		you type has to appear somewhere. Requirements and OTLP messages link upstream, to the document
		at the tracked tag. The whole index is one file:{" "}
		<a href="/api/search.json" class="font-mono">/api/search.json</a>.
	</p>
</Shell>

<script>
	interface Entry {
		type: string
		id: string
		text: string
		url: string
		meta: string
	}

	const input = document.getElementById("q") as HTMLInputElement
	const results = document.getElementById("results") as HTMLElement
	const status = document.getElementById("status") as HTMLElement
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".type-btn"))

	const TYPE_LABEL: Record<string, string> = {
		attribute: "attribute",
		metric: "metric",
		span: "span",
		event: "event",
		entity: "entity",
		requirement: "requirement",
		otlp: "otlp",
		domain: "domain",
	}
	// Domains first: one of them is usually a better answer than any single row.
	const TYPE_RANK: Record<string, number> = {
		domain: 0,
		attribute: 1,
		metric: 2,
		span: 3,
		event: 4,
		entity: 5,
		otlp: 6,
		requirement: 7,
	}
	const SIGNAL_TYPES = new Set(["span", "event", "entity"])

	const LIMIT = 80

	let entries: (Entry & { haystack: string; lowerId: string })[] = []
	let type = "all"

	const inType = (entry: Entry) =>
		type === "all" || (type === "signal" ? SIGNAL_TYPES.has(entry.type) : entry.type === type)

	/** Exact id, then id prefix, then id, then prose. Cheap and predictable. */
	function score(entry: (typeof entries)[number], terms: string[]): number | null {
		for (const term of terms) if (!entry.haystack.includes(term)) return null
		const first = terms[0] as string
		if (entry.lowerId === first) return 0
		if (entry.lowerId.startsWith(first)) return 1
		if (entry.lowerId.includes(first)) return 2
		if (entry.text.toLowerCase().includes(first)) return 3
		return 4
	}

	function render() {
		const query = input.value.trim().toLowerCase()
		const terms = query.split(/\s+/).filter(Boolean)

		if (terms.length === 0) {
			results.replaceChildren()
			status.textContent = `${entries.length.toLocaleString("en-GB")} definitions indexed. Start typing.`
			for (const button of buttons) {
				const count = button.querySelector(".type-count") as HTMLElement
				count.textContent = ""
			}
			return
		}

		const scored: { entry: (typeof entries)[number]; rank: number }[] = []
		const perType: Record<string, number> = {}
		for (const entry of entries) {
			const rank = score(entry, terms)
			if (rank === null) continue
			perType[entry.type] = (perType[entry.type] ?? 0) + 1
			if (!inType(entry)) continue
			scored.push({ entry, rank })
		}
		scored.sort(
			(a, b) =>
				a.rank - b.rank ||
				(TYPE_RANK[a.entry.type] ?? 9) - (TYPE_RANK[b.entry.type] ?? 9) ||
				a.entry.id.length - b.entry.id.length ||
				a.entry.id.localeCompare(b.entry.id),
		)

		for (const button of buttons) {
			const value = button.dataset["type"] ?? "all"
			const count = button.querySelector(".type-count") as HTMLElement
			const n =
				value === "all"
					? Object.values(perType).reduce((sum, x) => sum + x, 0)
					: value === "signal"
						? [...SIGNAL_TYPES].reduce((sum, key) => sum + (perType[key] ?? 0), 0)
						: (perType[value] ?? 0)
			count.textContent = ` ${n}`
			button.classList.toggle("opacity-40", value !== "all" && n === 0)
		}

		results.replaceChildren(...scored.slice(0, LIMIT).map((hit) => row(hit.entry)))
		status.textContent =
			scored.length === 0
				? "Nothing matches."
				: scored.length > LIMIT
					? `Showing the first ${LIMIT} of ${scored.length} matches.`
					: `${scored.length} ${scored.length === 1 ? "match" : "matches"}.`

		const url = new URL(location.href)
		if (input.value.trim()) url.searchParams.set("q", input.value.trim())
		else url.searchParams.delete("q")
		if (type === "all") url.searchParams.delete("type")
		else url.searchParams.set("type", type)
		history.replaceState(null, "", url)
	}

	function row(entry: Entry): HTMLElement {
		const li = document.createElement("li")
		li.className = "border-b border-rule py-2"

		const head = document.createElement("div")
		head.className = "flex flex-wrap items-baseline gap-x-2.5 gap-y-1"

		const tag = document.createElement("span")
		tag.className = "text-[11px] uppercase tracking-wide text-faint w-[5.5rem] shrink-0"
		tag.textContent = TYPE_LABEL[entry.type] ?? entry.type

		const link = document.createElement("a")
		link.href = entry.url
		link.className = "font-mono text-[13.5px] font-medium break-all"
		link.textContent = entry.id

		const meta = document.createElement("span")
		meta.className = "text-[12px] text-faint"
		meta.textContent = entry.meta

		head.append(tag, link, meta)

		const body = document.createElement("p")
		body.className = "mt-0.5 mb-0 pl-0 sm:pl-[5.5rem] text-[13.5px] text-muted max-w-[86ch]"
		body.textContent = entry.text

		li.append(head)
		if (entry.text) li.append(body)
		return li
	}

	for (const button of buttons) {
		button.addEventListener("click", () => {
			type = button.dataset["type"] ?? "all"
			for (const other of buttons) other.toggleAttribute("data-on", other === button)
			render()
		})
	}
	input.addEventListener("input", render)

	const params = new URLSearchParams(location.search)
	input.value = params.get("q") ?? ""
	const initialType = params.get("type")
	if (initialType && buttons.some((b) => b.dataset["type"] === initialType)) {
		type = initialType
		for (const button of buttons) button.toggleAttribute("data-on", button.dataset["type"] === initialType)
	}

	const response = await fetch("/api/search.json")
	const payload = (await response.json()) as { entries: Entry[] }
	entries = payload.entries.map((entry) => ({
		...entry,
		lowerId: entry.id.toLowerCase(),
		haystack: `${entry.id} ${entry.text} ${entry.meta}`.toLowerCase(),
	}))
	render()
	input.focus()
</script>
