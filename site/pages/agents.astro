---
import Icon from "../components/Icon.astro"
import InstallTabs from "../components/InstallTabs.astro"
import ToolExamples from "../components/ToolExamples.astro"
import Shell from "../layouts/Shell.astro"
import { catalog } from "../../src/model/catalog.ts"
import { TOOLS } from "../../src/mcp/worker.ts"
import { TOOL_ICON } from "../lib/icons.ts"
import { SITE } from "../lib/site.ts"

/**
 * The page for someone whose first question is "can my agent use this?".
 * The tool list is the same array the Worker advertises, so a tool added there
 * shows up here on the next build. The one-line summaries are for people; the
 * full description under each is what the model reads.
 */
const data = await catalog()
const mcp = `${SITE.origin}/mcp`

const SUMMARY: Record<string, string> = {
	search: "One question in, ranked hits from everything on the site. The place to start.",
	list_versions: "Every tracked release of each source, with dates and change counts.",
	check_attribute_names: "Takes the keys your code emits. Reports which are renamed, deprecated or unknown.",
	get_attribute: "One attribute in full, with its release-by-release history.",
	search_attributes: "Filter the registry by text, namespace, or deprecated entries only.",
	diff_versions: "Every change between two releases of one source, most severe first.",
	search_requirements: "Every MUST, SHOULD and MAY in the spec and in OTLP, with links to the section.",
	get_otlp_message: "One OTLP message or enum with its field numbers, types and cardinality.",
}

const prompts = [
	{
		title: "Audit the attributes a service emits",
		prompt:
			"Find every OpenTelemetry attribute key this repository sets on spans, logs or metrics, then check them against semconv.com with check_attribute_names. List the ones that are deprecated or renamed, with the replacement for each, and tell me which files set them.",
	},
	{
		title: "Prepare an upgrade",
		prompt: `We instrument against semantic conventions v${data.semconv.versions.at(-1)}. Use diff_versions on semconv.com to list every breaking and notable change up to v${data.semconv.latest.version} that touches the http, db and messaging namespaces, and say which of them affect this codebase.`,
	},
	{
		title: "Answer a spec question with a citation",
		prompt:
			"Using semconv.com's search_requirements, what does the OpenTelemetry specification require of an SDK when the exporter returns a retryable error? Quote the MUST/SHOULD lines and link the section.",
	},
	{
		title: "Name a new attribute correctly",
		prompt:
			"I want to record the size of a queue in a span. Search semconv.com for existing attributes or metrics that already cover this before we invent a custom key, and recommend one.",
	},
]

const curl = `curl -s ${mcp} \\
  -H 'content-type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"search","arguments":{"query":"which attribute holds the http status code"}}}'`

const endpoints = [
	["/llms.txt", "The map of this surface, for a model to read first."],
	["/api/search.json", "One index over everything, with a type and URL per row."],
	["/api/attributes/{id}.json", "One attribute in full, plus its release history."],
	["/api/renames.json", "Every deprecated name and its successor."],
	["/api/diff/{source}/{from}...{to}.json", "Every change between two tracked versions."],
	["/api/requirements.json", "Every MUST, SHOULD and MAY in the spec and in OTLP."],
	["/feed.xml", "RSS, one entry per release."],
]
---

<Shell
	title="Use with your agent"
	description="semconv.com is a public MCP server and a JSON API. Point Claude Code, Codex, Cursor or any MCP client at it and your agent stops guessing attribute names."
>
	<p class="eyebrow">Agents</p>
	<h1 class="mt-3 mb-0 max-w-[20ch] text-[2.1rem] leading-[1.1] font-semibold tracking-[-0.03em]">
		Your agent should not guess attribute names
	</h1>
	<p class="mt-4 mb-0 max-w-[60ch] text-[15px] leading-relaxed text-muted">
		A model's training data is months behind the registry, and the conventions rename keys most
		releases. This site is also a read-only MCP server at <code class="code-chip">{mcp}</code>. No key,
		no account, one URL. Add it once and your agent checks the registry instead of its memory.
	</p>

	<section class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-2">
		<div class="min-w-0">
			<h2 class="eyebrow">Add it to your client</h2>
			<div class="mt-4">
				<InstallTabs />
			</div>
			<p class="mt-4 mb-0 text-[13px] leading-relaxed text-faint">
				Streamable HTTP with one JSON response per call. CORS is open, so an agent running in a browser
				can call it too.
			</p>
		</div>
		<div class="min-w-0">
			<h2 class="eyebrow">What it looks like</h2>
			<div class="mt-4">
				<ToolExamples />
			</div>
		</div>
	</section>

	<section class="mt-16 border-t border-rule pt-10">
		<span class="icon-tile"><Icon name="brackets" /></span>
		<h2 class="section-title mt-4">{TOOLS.length} tools</h2>
		<p class="mt-3 mb-0 max-w-[62ch] text-[14px] leading-relaxed text-muted">
			Each reads the same JSON the pages are built from, so the site and your agent cannot disagree.
			Open one to see the description the model is given.
		</p>
		<ul class="hairline-grid mt-6 m-0 list-none p-0 sm:grid-cols-2">
			{
				TOOLS.map((tool) => (
					<li class="hairline-cell">
						<div class="flex items-center gap-2.5">
							<Icon name={TOOL_ICON[tool.name] ?? "brackets"} class="h-4 w-4 text-muted" />
							<code class="font-mono text-[13.5px] font-semibold text-ink">{tool.name}</code>
						</div>
						<p class="mt-1.5 mb-0 text-[13.5px] leading-relaxed text-muted">{SUMMARY[tool.name] ?? tool.description}</p>
						<details class="group mt-3">
							<summary class="cursor-pointer list-none text-[12.5px] text-faint transition-colors hover:text-ink">
								<span class="group-open:hidden">What the model reads</span>
								<span class="hidden group-open:inline">Hide</span>
							</summary>
							<p class="mt-2 mb-0 text-[12.5px] leading-relaxed text-faint">{tool.description}</p>
						</details>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-16 border-t border-rule pt-10">
		<span class="icon-tile"><Icon name="msgs" /></span>
		<h2 class="section-title mt-4">Things to ask it</h2>
		<p class="mt-3 mb-0 max-w-[62ch] text-[14px] leading-relaxed text-muted">
			Copy one into your agent. Each names the tool, so the agent reaches for the server rather than its
			memory.
		</p>
		<ul class="mt-6 m-0 grid list-none gap-3 p-0 md:grid-cols-2">
			{
				prompts.map((p) => (
					<li class="callout flex flex-col">
						<div class="flex items-start justify-between gap-3">
							<p class="m-0 text-[13.5px] font-medium text-ink">{p.title}</p>
							<button type="button" class="copy-btn shrink-0" data-copy={p.prompt}>
								Copy
							</button>
						</div>
						<p class="mt-2 mb-0 text-[13px] leading-relaxed text-muted">{p.prompt}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-16 border-t border-rule pt-10">
		<span class="icon-tile"><Icon name="plug" /></span>
		<h2 class="section-title mt-4">Without an MCP client</h2>
		<p class="mt-3 mb-0 max-w-[62ch] text-[14px] leading-relaxed text-muted">
			The server is plain JSON-RPC over POST, and <code class="code-chip">search</code> is the tool to
			start with. Every page also has a static JSON twin an agent can fetch.
		</p>
		<div class="mt-5 flex items-start gap-2 rounded-lg border border-rule bg-elevated py-2 pr-2 pl-4">
			<pre class="m-0 min-w-0 flex-1 overflow-x-auto py-1 font-mono text-[12.5px] leading-relaxed"><code>{curl}</code></pre>
			<button type="button" class="copy-btn mt-0.5 shrink-0" data-copy={curl}>Copy</button>
		</div>
		<ul class="mt-6 m-0 list-none p-0 text-[13.5px]">
			{
				endpoints.map(([path, what]) => (
					<li class="flex flex-wrap items-baseline gap-x-4 gap-y-0.5 border-b border-rule py-2 last:border-0">
						<a href={path?.replace(/\{.*$/, "")} class="font-mono text-[13px] no-underline hover:underline">
							{path}
						</a>
						<span class="text-muted">{what}</span>
					</li>
				))
			}
		</ul>
	</section>
</Shell>
