---
import Pill from "../../components/Pill.astro"
import Shell from "../../layouts/Shell.astro"
import { catalog } from "../../../src/model/catalog.ts"
import { DOMAINS, domainForNamespace, registryAttributes } from "../../../src/model/domains.ts"
import { attributeHref, STABILITY_LABEL, stabilityClass } from "../../lib/format.ts"

const data = await catalog()

const rows = registryAttributes(data)
	.map(({ attribute, registry }) => ({
		id: attribute.id,
		// Briefs are Markdown; these rows are plain text, so links collapse to
		// their label rather than showing the URL mid-sentence.
		brief: attribute.brief
			.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
			.replace(/`/g, "")
			.replace(/\s+/g, " ")
			.trim()
			.slice(0, 180),
		namespace: attribute.namespace,
		registry,
		stability: attribute.stability,
		deprecated: Boolean(attribute.deprecated),
		renamedTo: attribute.deprecated?.renamedTo ?? "",
		type: attribute.type,
		// One lowercase haystack per row keeps the filter a single substring test.
		search: `${attribute.id} ${attribute.brief} ${attribute.type}`.toLowerCase(),
	}))
	.sort((x, y) => x.id.localeCompare(y.id))

/**
 * Grouped by namespace rather than run as one 963-row scroll. The namespace is
 * the unit the registry is actually written in — `db.*` is designed together —
 * and it is what makes a domain out of a list.
 */
const groups = [...new Set(rows.map((row) => row.namespace))].sort().map((namespace) => ({
	namespace,
	domain: domainForNamespace(namespace),
	rows: rows.filter((row) => row.namespace === namespace),
}))

const counts = {
	all: rows.length,
	stable: rows.filter((r) => r.stability === "stable" && !r.deprecated).length,
	deprecated: rows.filter((r) => r.deprecated).length,
	genai: rows.filter((r) => r.registry === "genai").length,
}
---

<Shell
	title="Attribute registry"
	description={`All ${counts.all} attributes in the OpenTelemetry semantic conventions, grouped by namespace, with stability, type and deprecation status.`}
	wide
>
	<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
		<h1 class="m-0 text-[1.7rem] font-semibold tracking-[-0.02em]">Attribute registry</h1>
		<span class="text-[13.5px] text-faint">as of v{data.semconv.latest.version}</span>
	</div>
	<p class="mt-2 mb-0 text-muted max-w-[68ch]">
		Every attribute the conventions define, plus the GenAI registry that was split out of them in
		v1.44.0, grouped by namespace. Deprecated entries stay in the registry, so a name that still
		resolves here may already have a successor &mdash; that is what the arrow means. For one topic in
		full, with its metrics, spans and the requirements that bind them, see <a href="/domains">domains</a>.
	</p>

	<div class="mt-6 flex flex-wrap items-center gap-3">
		<input
			id="q"
			type="search"
			placeholder="Filter by name, description or type…"
			autocomplete="off"
			spellcheck="false"
			class="flex-1 min-w-[16rem] rounded-md border border-rule bg-surface px-3 py-2 font-mono text-[13.5px] outline-none focus:border-rule-strong"
		/>
		<select
			id="domain"
			aria-label="Filter by domain"
			class="rounded-md border border-rule bg-surface px-2.5 py-2 text-[13px] text-muted outline-none focus:border-rule-strong"
		>
			<option value="all">All domains</option>
			{DOMAINS.map((domain) => <option value={domain.slug}>{domain.title}</option>)}
		</select>
		<div class="flex gap-1.5" role="group" aria-label="Filter by status">
			{
				(
					[
						["all", `All ${counts.all}`],
						["stable", `Stable ${counts.stable}`],
						["deprecated", `Deprecated ${counts.deprecated}`],
						["genai", `GenAI ${counts.genai}`],
					] as const
				).map(([value, label]) => (
					<button
						type="button"
						data-filter={value}
						class="filter-btn rounded-md border border-rule px-2.5 py-1.5 text-[13px] text-muted hover:text-ink data-[on]:border-rule-strong data-[on]:text-ink data-[on]:font-medium"
						data-on={value === "all" ? "" : undefined}
					>
						{label}
					</button>
				))
			}
		</div>
	</div>

	<p id="count" class="mt-3 mb-0 text-[13px] text-faint" aria-live="polite"></p>

	<nav
		id="index"
		class="mt-3 flex flex-wrap gap-x-2.5 gap-y-0.5 border-y border-rule py-2 font-mono text-[12px] text-muted"
		aria-label="Jump to namespace"
	>
		{
			groups.map((group) => (
				<a href={`#ns-${group.namespace}`} class="no-underline hover:text-ink" data-index={group.namespace}>
					{group.namespace}
				</a>
			))
		}
	</nav>

	<div class="mt-6 flex flex-col gap-8" id="list">
		{
			groups.map((group) => (
				<section class="ns-group" data-namespace={group.namespace} data-domain={group.domain?.slug ?? ""}>
					<h2
						id={`ns-${group.namespace}`}
						class="m-0 flex flex-wrap items-baseline gap-x-2.5 border-b border-rule-strong pb-1 font-mono text-[14px] font-semibold"
					>
						{group.namespace}
						<span class="ns-count font-sans text-[12px] font-normal text-faint">{group.rows.length} attributes</span>
						{group.domain && (
							<a
								href={`/domains/${group.domain.slug}`}
								class="ml-auto font-sans text-[12.5px] font-normal text-muted no-underline hover:text-ink"
							>
								{group.domain.title} &rarr;
							</a>
						)}
					</h2>
					<ul class="m-0 list-none p-0">
						{group.rows.map((row) => (
							<li
								class="attr-row grid grid-cols-1 sm:grid-cols-[minmax(0,22rem)_1fr] gap-x-5 gap-y-0.5 items-baseline border-b border-rule py-2"
								data-search={row.search}
								data-stability={row.stability}
								data-registry={row.registry}
								data-deprecated={row.deprecated ? "1" : "0"}
							>
								<a href={attributeHref(row.id)} class="font-mono text-[13.5px] font-medium no-underline hover:underline break-all">
									{row.id}
								</a>
								<div class="min-w-0 flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
									<Pill
										label={row.deprecated ? "Deprecated" : (STABILITY_LABEL[row.stability] ?? row.stability)}
										class={stabilityClass(row.stability, row.deprecated)}
									/>
									{row.registry === "genai" && (
										<Pill label="GenAI" class="text-rc bg-rc-bg" title="Defined in the GenAI conventions registry" />
									)}
									{row.renamedTo && (
										<a href={attributeHref(row.renamedTo)} class="font-mono text-[12.5px] text-muted">
											&rarr; {row.renamedTo}
										</a>
									)}
									<span class="text-[13px] text-muted truncate">{row.brief}</span>
								</div>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>

	<p id="empty" class="mt-8 text-muted" hidden>No attribute matches that filter.</p>
</Shell>

<script>
	// Plain DOM filtering: ~950 rows is well within what the browser handles
	// without a framework, and it keeps the page working as a static document.
	const input = document.getElementById("q") as HTMLInputElement
	const domainSelect = document.getElementById("domain") as HTMLSelectElement
	const groups = Array.from(document.querySelectorAll<HTMLElement>(".ns-group")).map((element) => ({
		element,
		namespace: element.dataset["namespace"] ?? "",
		domain: element.dataset["domain"] ?? "",
		count: element.querySelector(".ns-count") as HTMLElement,
		rows: Array.from(element.querySelectorAll<HTMLElement>(".attr-row")),
	}))
	const indexLinks = Array.from(document.querySelectorAll<HTMLElement>("[data-index]"))
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn"))
	const count = document.getElementById("count") as HTMLElement
	const empty = document.getElementById("empty") as HTMLElement

	let status = "all"
	const total = groups.reduce((n, group) => n + group.rows.length, 0)

	const matchesStatus = (row: HTMLElement) => {
		if (status === "all") return true
		if (status === "deprecated") return row.dataset["deprecated"] === "1"
		if (status === "genai") return row.dataset["registry"] === "genai"
		return row.dataset["stability"] === "stable" && row.dataset["deprecated"] !== "1"
	}

	function apply() {
		const query = input.value.trim().toLowerCase()
		const domain = domainSelect.value
		let visible = 0
		const shown = new Set<string>()

		for (const group of groups) {
			if (domain !== "all" && group.domain !== domain) {
				group.element.hidden = true
				continue
			}
			let inGroup = 0
			for (const row of group.rows) {
				const show = matchesStatus(row) && (query === "" || (row.dataset["search"] ?? "").includes(query))
				row.hidden = !show
				if (show) inGroup++
			}
			group.count.textContent = inGroup === group.rows.length ? `${inGroup} attributes` : `${inGroup} of ${group.rows.length}`
			group.element.hidden = inGroup === 0
			if (inGroup > 0) shown.add(group.namespace)
			visible += inGroup
		}

		for (const link of indexLinks) link.hidden = !shown.has(link.dataset["index"] ?? "")

		count.textContent = `${visible} of ${total} attributes in ${shown.size} namespace${shown.size === 1 ? "" : "s"}`
		empty.hidden = visible > 0
	}

	input.addEventListener("input", apply)
	domainSelect.addEventListener("change", apply)
	for (const button of buttons) {
		button.addEventListener("click", () => {
			status = button.dataset["filter"] ?? "all"
			for (const other of buttons) other.toggleAttribute("data-on", other === button)
			apply()
		})
	}

	// `?q=`, `?registry=` and `?domain=` make a filtered view linkable.
	const params = new URLSearchParams(location.search)
	const initial = params.get("q")
	if (initial) input.value = initial
	if (params.get("registry") === "genai") {
		status = "genai"
		for (const button of buttons) button.toggleAttribute("data-on", button.dataset["filter"] === "genai")
	}
	const domain = params.get("domain")
	if (domain && Array.from(domainSelect.options).some((option) => option.value === domain)) domainSelect.value = domain
	apply()
</script>
