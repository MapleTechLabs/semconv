---
import ChangeList from "../../components/ChangeList.astro"
import Pill from "../../components/Pill.astro"
import Shell from "../../layouts/Shell.astro"
import { catalog } from "../../../src/model/catalog.ts"
import { formatDate, SEVERITY_LABEL, severityClass } from "../../lib/format.ts"
import type { Severity } from "../../../src/model/diff.ts"

export async function getStaticPaths() {
	const data = await catalog()
	return data.diffs.map((diff) => ({ params: { version: diff.to }, props: { diff } }))
}

const { diff } = Astro.props
const data = await catalog()

const release = data.releases.find((r) => r.version === diff.to)
const linkable = new Set(data.attributes.map((a) => a.id))
const index = data.diffs.findIndex((d) => d.to === diff.to)
const newer = index > 0 ? data.diffs[index - 1] : undefined
const older = data.diffs[index + 1]

const sections = (["breaking", "notable", "informational"] as Severity[])
	.map((severity) => ({ severity, changes: diff.changes.filter((c) => c.severity === severity) }))
	.filter((section) => section.changes.length > 0)

/**
 * The upstream body is Markdown we do not control, so it is never rendered as
 * markup. Top-level bullets are lifted out as plain text to convey what the
 * maintainers themselves considered important; indented sub-bullets are dropped
 * because they enumerate the same renames our own diff already lists, and the
 * trailing issue references are noise at this size.
 */
const upstreamBullets = (release?.body ?? "")
	.split("\n")
	.filter((line) => line.startsWith("- "))
	.map((line) =>
		line
			.slice(2)
			.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
			.replace(/\s*\(#\d+\)\s*$/, "")
			.replace(/`/g, "")
			.replace(/\s+/g, " ")
			.trim(),
	)
	.filter((line) => line.length > 0)
	.slice(0, 10)
---

<Shell
	title={`Semantic conventions v${diff.to}`}
	description={`What changed in OpenTelemetry semantic conventions v${diff.to}: ${diff.counts.breaking} breaking, ${diff.counts.notable} notable and ${diff.counts.informational} editorial changes since v${diff.from}.`}
>
	<nav class="text-[13px] text-faint"><a href="/">Changes</a></nav>

	<div class="mt-2 flex flex-wrap items-baseline gap-x-4 gap-y-1">
		<h1 class="m-0 font-mono text-[1.7rem] font-semibold tracking-tight">v{diff.to}</h1>
		{
			release && (
				<time class="text-[13.5px] text-faint" datetime={release.publishedAt}>
					{formatDate(release.publishedAt)}
				</time>
			)
		}
		<span class="text-[13.5px] text-muted">since v{diff.from}</span>
	</div>

	<div class="mt-4 flex flex-wrap gap-1.5">
		{
			(["breaking", "notable", "informational"] as Severity[]).map((severity) => (
				<Pill
					label={`${diff.counts[severity]} ${SEVERITY_LABEL[severity].toLowerCase()}`}
					class={severityClass(severity)}
				/>
			))
		}
	</div>

	{
		upstreamBullets.length > 0 && (
			<section class="mt-7 rounded-md border border-rule bg-surface px-4 py-3">
				<h2 class="m-0 text-[11px] uppercase tracking-[0.12em] text-faint font-semibold">
					From the upstream release notes
				</h2>
				<ul class="mt-2 m-0 pl-4 flex flex-col gap-1.5 text-[13.5px] text-muted">
					{upstreamBullets.map((line) => (
						<li>{line}</li>
					))}
				</ul>
				{release && (
					<p class="mt-3 mb-0 text-[13px]">
						<a href={release.url}>Read the full release notes</a>
					</p>
				)}
			</section>
		)
	}

	{
		sections.map((section) => (
			<section class="mt-9">
				<h2 class="flex items-baseline gap-2.5 m-0 text-[1.05rem] font-semibold">
					{SEVERITY_LABEL[section.severity]}
					<span class="text-[13px] font-normal text-faint">{section.changes.length}</span>
				</h2>
				{section.severity === "breaking" && (
					<p class="mt-1 mb-0 text-[13.5px] text-muted max-w-[68ch]">
						Changes to definitions the project had already marked stable or release candidate.
					</p>
				)}
				<div class="mt-2">
					<ChangeList changes={section.changes} linkable={linkable} />
				</div>
			</section>
		))
	}

	<nav class="mt-12 flex justify-between gap-4 border-t border-rule pt-4 text-[13.5px]">
		<span>{older && <a href={`/releases/${older.to}`}>&larr; v{older.to}</a>}</span>
		<span>{newer && <a href={`/releases/${newer.to}`}>v{newer.to} &rarr;</a>}</span>
	</nav>
</Shell>
