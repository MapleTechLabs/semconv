{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"strict": true,
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"jsx": "preserve",
		"baseUrl": ".",
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src/**/*.ts", "site/src/**/*.ts"]
}
